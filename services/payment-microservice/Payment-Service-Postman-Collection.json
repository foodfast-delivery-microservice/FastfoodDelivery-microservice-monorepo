{
    "info": {
        "_postman_id": "payment-service-api-collection",
        "name": "Payment Service API",
        "description": "Collection for testing Payment Service REST APIs including Payment Processing and Statistics",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Payment Processing",
            "item": [
                {
                    "name": "Process Payment",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"orderId\": 1,\n  \"paymentMethod\": \"CASH\",\n  \"amount\": 150000\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/payments",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "payments"
                            ]
                        },
                        "description": "Process payment for an order. Payment methods: CASH, CREDIT_CARD, E_WALLET"
                    },
                    "response": []
                },
                {
                    "name": "Get Payment by Order ID",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/payments/order/{{order_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "payments",
                                "order",
                                "{{order_id}}"
                            ]
                        },
                        "description": "Get payment information by order ID (for internal use by Order Service)"
                    },
                    "response": []
                }
            ],
            "description": "Endpoints for processing payments"
        },
        {
            "name": "Merchant Payments",
            "item": [
                {
                    "name": "Get My Merchant Payments",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/payments/merchants/me?status=&page=0&size=20&sortBy=createdAt&sortDirection=DESC&fromDate=&toDate=",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "payments",
                                "merchants",
                                "me"
                            ],
                            "query": [
                                {
                                    "key": "status",
                                    "value": "",
                                    "description": "Payment status filter (SUCCESS, PENDING, FAILED)"
                                },
                                {
                                    "key": "page",
                                    "value": "0"
                                },
                                {
                                    "key": "size",
                                    "value": "20"
                                },
                                {
                                    "key": "sortBy",
                                    "value": "createdAt"
                                },
                                {
                                    "key": "sortDirection",
                                    "value": "DESC"
                                },
                                {
                                    "key": "fromDate",
                                    "value": "",
                                    "description": "Start date (ISO format)"
                                },
                                {
                                    "key": "toDate",
                                    "value": "",
                                    "description": "End date (ISO format)"
                                }
                            ]
                        },
                        "description": "Get payment list for current merchant (Merchant role required)"
                    },
                    "response": []
                },
                {
                    "name": "Get My Merchant Payment Statistics",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/payments/merchants/me/statistics?fromDate=&toDate=",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "payments",
                                "merchants",
                                "me",
                                "statistics"
                            ],
                            "query": [
                                {
                                    "key": "fromDate",
                                    "value": "",
                                    "description": "Start date (ISO format)"
                                },
                                {
                                    "key": "toDate",
                                    "value": "",
                                    "description": "End date (ISO format)"
                                }
                            ]
                        },
                        "description": "Get revenue statistics for current merchant"
                    },
                    "response": []
                },
                {
                    "name": "Get Merchant Statistics (Admin)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/payments/merchants/{{merchant_id}}/statistics?fromDate=&toDate=",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "payments",
                                "merchants",
                                "{{merchant_id}}",
                                "statistics"
                            ],
                            "query": [
                                {
                                    "key": "fromDate",
                                    "value": "",
                                    "description": "Start date (ISO format)"
                                },
                                {
                                    "key": "toDate",
                                    "value": "",
                                    "description": "End date (ISO format)"
                                }
                            ]
                        },
                        "description": "Get revenue statistics for a specific merchant (Admin only)"
                    },
                    "response": []
                }
            ],
            "description": "Endpoints for merchants to view payments and statistics"
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8085",
            "type": "string"
        },
        {
            "key": "jwt_token",
            "value": "",
            "type": "string"
        },
        {
            "key": "order_id",
            "value": "1",
            "type": "string"
        },
        {
            "key": "merchant_id",
            "value": "1",
            "type": "string"
        }
    ]
}