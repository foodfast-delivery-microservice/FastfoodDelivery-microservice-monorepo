{
    "info": {
        "_postman_id": "product-service-api-collection",
        "name": "Product Service API",
        "description": "Collection for testing Product Service REST APIs including Product Management and File Upload",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Product Management",
            "item": [
                {
                    "name": "Create Product",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Phở Bò\",\n  \"description\": \"Phở bò truyền thống Hà Nội\",\n  \"price\": 50000,\n  \"category\": \"Vietnamese\",\n  \"imageUrl\": \"/api/v1/files/sample.jpg\",\n  \"available\": true\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/products",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "products"
                            ]
                        },
                        "description": "Create a new product (Merchant/Admin only)"
                    },
                    "response": []
                },
                {
                    "name": "Get All Products",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/products?merchantId=",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "products"
                            ],
                            "query": [
                                {
                                    "key": "merchantId",
                                    "value": "",
                                    "description": "Optional filter by merchant ID"
                                }
                            ]
                        },
                        "description": "Get all products (public endpoint)"
                    },
                    "response": []
                },
                {
                    "name": "Get Product by ID",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/products/{{product_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "products",
                                "{{product_id}}"
                            ]
                        },
                        "description": "Get a specific product by ID"
                    },
                    "response": []
                },
                {
                    "name": "Get Products by Category",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/products/category/{{category}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "products",
                                "category",
                                "{{category}}"
                            ]
                        },
                        "description": "Get all products in a specific category"
                    },
                    "response": []
                },
                {
                    "name": "Get Products by Merchant (Public)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/products/merchants/{{merchant_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "products",
                                "merchants",
                                "{{merchant_id}}"
                            ]
                        },
                        "description": "Get all active products from a specific merchant (public endpoint)"
                    },
                    "response": []
                },
                {
                    "name": "Get My Merchant Products",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/products/merchants/me?merchantId=&includeInactive=false",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "products",
                                "merchants",
                                "me"
                            ],
                            "query": [
                                {
                                    "key": "merchantId",
                                    "value": "",
                                    "description": "Optional merchant ID (Admin only)"
                                },
                                {
                                    "key": "includeInactive",
                                    "value": "false",
                                    "description": "Include inactive products"
                                }
                            ]
                        },
                        "description": "Get current merchant's products (Merchant/Admin authenticated)"
                    },
                    "response": []
                },
                {
                    "name": "Update Product",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Phở Bò Đặc Biệt\",\n  \"price\": 60000,\n  \"available\": true\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/products/{{product_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "products",
                                "{{product_id}}"
                            ]
                        },
                        "description": "Update product information (Merchant/Admin only)"
                    },
                    "response": []
                },
                {
                    "name": "Delete Product",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/products/{{product_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "products",
                                "{{product_id}}"
                            ]
                        },
                        "description": "Delete a product (Merchant/Admin only)"
                    },
                    "response": []
                },
                {
                    "name": "Validate Products",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "[\n  {\n    \"productId\": 1,\n    \"quantity\": 2\n  },\n  {\n    \"productId\": 2,\n    \"quantity\": 1\n  }\n]"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/products/validate",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "products",
                                "validate"
                            ]
                        },
                        "description": "Validate product availability and stock (internal API)"
                    },
                    "response": []
                },
                {
                    "name": "Ping",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/products/ping",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "products",
                                "ping"
                            ]
                        },
                        "description": "Health check endpoint"
                    },
                    "response": []
                }
            ],
            "description": "Endpoints for managing products and menu items"
        },
        {
            "name": "File Upload",
            "item": [
                {
                    "name": "Upload Image",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
                            }
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "file",
                                    "type": "file",
                                    "src": []
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/upload/image",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "upload",
                                "image"
                            ]
                        },
                        "description": "Upload product image (max 5MB, images only)"
                    },
                    "response": []
                }
            ],
            "description": "Endpoints for uploading product images"
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8083",
            "type": "string"
        },
        {
            "key": "jwt_token",
            "value": "",
            "type": "string"
        },
        {
            "key": "product_id",
            "value": "1",
            "type": "string"
        },
        {
            "key": "merchant_id",
            "value": "1",
            "type": "string"
        },
        {
            "key": "category",
            "value": "Vietnamese",
            "type": "string"
        }
    ]
}