            "name": "Order Management",
            "item": [
                {
                    "name": "Create Order",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
                            },
                            {
                                "key": "Idempotency-Key",
                                "value": "{{$guid}}",
                                "description": "Optional - prevents duplicate orders"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"restaurantId\": 1,\n  \"deliveryAddressId\": 1,\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 2,\n      \"specialInstructions\": \"Extra spicy\"\n    }\n  ],\n  \"specialInstructions\": \"Call when arrived\",\n  \"paymentMethod\": \"CASH\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/orders",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "orders"
                            ]
                        },
                        "description": "Create a new order with delivery information and items"
                    },
                    "response": []
