# .env.example - FastFood Delivery Environment Template
# Copy this file to .env and fill in the values
# ⚠️ NEVER commit the actual .env file

# --- MySQL Database ---
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=<your-mysql-password>

# --- JWT Secret Key (HS512, Base64-encoded 512-bit key) ---
# Generate with: openssl rand -base64 64
APP_JWT_SECRETKEY=<your-base64-encoded-jwt-secret>

# --- Email Service (Gmail SMTP App Password) ---
# See docs/GMAIL_SETUP_GUIDE.md for instructions
MAIL_USERNAME=<your-email@gmail.com>
MAIL_PASSWORD=<your-gmail-app-password>

# --- RabbitMQ ---
# ⚠️ Change from default guest:guest for production!
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
